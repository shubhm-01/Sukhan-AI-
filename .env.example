# Existing server-side Gemini text/poetry fallback (optional).
GEMINI_API_KEY=""

# Public HTTPS Node backend URL used by standalone Android APKs.
VITE_API_BASE_URL=""

# Firebase Admin: use Cloud Run Application Default Credentials where possible.
# For local development only, this may be a service-account JSON string.
FIREBASE_PROJECT_ID="storied-hawk-tn50x"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# LiveKit Cloud server credentials. Keep these on the Node backend and agent worker.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_AGENT_NAME="sukhan-live"

# Groq API key for the LiveKit worker (free-tier quotas apply).
GROQ_API_KEY=""
GROQ_LLM_MODEL="openai/gpt-oss-120b"
GROQ_STT_MODEL="whisper-large-v3-turbo"

# Voice defaults for the Edge TTS adapter.
EDGE_TTS_VOICE_URDU="ur-PK-UzmaNeural"
EDGE_TTS_VOICE_HINDI="hi-IN-SwaraNeural"
EDGE_TTS_VOICE_ENGLISH="en-IN-NeerjaNeural"
